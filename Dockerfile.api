FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY apps/customer/package.json apps/customer/package.json
COPY apps/owner/package.json apps/owner/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/theme/package.json packages/theme/package.json
COPY packages/validation/package.json packages/validation/package.json
COPY patana-api/package.json patana-api/package.json
RUN npm install --no-audit
COPY . .
RUN npm run build -w @patana/api

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=4000
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* && groupadd -r patana && useradd -r -g patana patana
COPY --from=build /app /app
USER patana
EXPOSE 4000
CMD ["node","patana-api/dist/main.js"]
