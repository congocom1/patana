# Database
DATABASE_URL=postgresql://patana:patana@localhost:5432/patana?schema=public

# CORS Origins (required in production)
CUSTOMER_ORIGIN=http://localhost:5173
OWNER_ORIGIN=http://localhost:5174

# Server
PORT=4000

# JWT (required - 32+ chars, cryptographically random)
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters

# Refresh Token (required for token rotation)
REFRESH_SECRET=replace-with-at-least-32-cryptographically-random-characters
REFRESH_TOKEN_TTL=7d

# Password Pepper (additional secret for password hashing)
PASSWORD_PEPPER=replace-with-random-pepper

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Stripe Payment Provider
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_API_VERSION=2024-12-18.acacia

# Admin webhook key for manual operations
ADMIN_WEBHOOK_KEY=replace-with-secure-random-string
